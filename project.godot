config_version=5

[application]
config/name="Geometry Defense"
config/version="0.4.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.105,0.12,0.135,1)

[display]
window/size/viewport_width=720
window/size/viewport_height=1600
window/size/window_width_override=450
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.105,0.12,0.135,1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

[editor_plugins]
enabled=PackedStringArray("res://addons/report_share/plugin.cfg")
